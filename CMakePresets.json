      "name": "tests",
      "displayName": "Host test build",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "rp2040-w5500",
      "displayName": "RP2040 + W5500",
      "binaryDir": "${sourceDir}/build/rp2040_w5500",
