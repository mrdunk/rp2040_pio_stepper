loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt hal_rp2040_eth num_joints=[KINS]JOINTS
loadrt and2 names=estop-gate
loadrt logic count=1 personality=0x104
loadrt conv_u32_float names=conv-seq-out,conv-seq-in
loadrt sum2 count=1

addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf rp2040_eth.0.write servo-thread
addf estop-gate servo-thread
addf logic.0 servo-thread
addf conv-seq-out servo-thread
addf conv-seq-in servo-thread
addf sum2.0 servo-thread


# Machine enable
# E-stop gate: cleared when UI e-stop is OK AND driver is connected
net user-ok    iocontrol.0.user-enable-out => estop-gate.in0
net driver-ok  rp2040_eth.0.machine-on     => estop-gate.in1
net estop-clear estop-gate.out             => iocontrol.0.emc-enable-in

# Joint enable: all four conditions must be true simultaneously
net user-ok                                        => logic.0.in-00
net driver-ok                                      => logic.0.in-01
net machine-is-on   halui.machine.is-on             => logic.0.in-02
net config-complete rp2040_eth.0.config-complete    => logic.0.in-03
net joints-enabled <= logic.0.and


# Joint 0 — X AXIS (J5: GP7=STEP, GP6=DIR via 74HCT541 buffer)
setp rp2040_eth.0.joint.0.scale          [JOINT_0]SCALE
setp rp2040_eth.0.joint.0.gpio-step      7
setp rp2040_eth.0.joint.0.gpio-dir       6
setp rp2040_eth.0.joint.0.cmd-type       0

setp rp2040_eth.0.joint.0.vel-limit    [JOINT_0]MAX_VELOCITY
setp rp2040_eth.0.joint.0.accel-limit       [JOINT_0]MAX_ACCELERATION

net xpos-cmd joint.0.motor-pos-cmd => rp2040_eth.0.joint.0.pos-cmd
net xvel-cmd joint.0.vel-cmd       => rp2040_eth.0.joint.0.vel-cmd
net xpos-fb  rp2040_eth.0.joint.0.pos-fb => joint.0.motor-pos-fb

net joints-enabled => rp2040_eth.0.joint.0.enable-cmd


# Joint 1 — Y AXIS (J4: GP5=STEP, GP4=DIR via 74HCT541 buffer)
setp rp2040_eth.0.joint.1.scale          [JOINT_1]SCALE
setp rp2040_eth.0.joint.1.gpio-step      5
setp rp2040_eth.0.joint.1.gpio-dir       4
setp rp2040_eth.0.joint.1.cmd-type       0

setp rp2040_eth.0.joint.1.vel-limit    [JOINT_1]MAX_VELOCITY
setp rp2040_eth.0.joint.1.accel-limit       [JOINT_1]MAX_ACCELERATION

net ypos-cmd joint.1.motor-pos-cmd => rp2040_eth.0.joint.1.pos-cmd
net yvel-cmd joint.1.vel-cmd       => rp2040_eth.0.joint.1.vel-cmd
net ypos-fb  rp2040_eth.0.joint.1.pos-fb => joint.1.motor-pos-fb

net joints-enabled => rp2040_eth.0.joint.1.enable-cmd


# Joint 2 — Z AXIS (J3: GP3=STEP, GP2=DIR via 74HCT541 buffer)
setp rp2040_eth.0.joint.2.scale          [JOINT_2]SCALE
setp rp2040_eth.0.joint.2.gpio-step      3
setp rp2040_eth.0.joint.2.gpio-dir       2
setp rp2040_eth.0.joint.2.cmd-type       0

setp rp2040_eth.0.joint.2.vel-limit    [JOINT_2]MAX_VELOCITY
setp rp2040_eth.0.joint.2.accel-limit       [JOINT_2]MAX_ACCELERATION

net zpos-cmd joint.2.motor-pos-cmd => rp2040_eth.0.joint.2.pos-cmd
net zvel-cmd joint.2.vel-cmd       => rp2040_eth.0.joint.2.vel-cmd
net zpos-fb  rp2040_eth.0.joint.2.pos-fb => joint.2.motor-pos-fb

net joints-enabled => rp2040_eth.0.joint.2.enable-cmd


# J2 (A-axis stepper connector) is wired to GP1=STEP, GP0=DIR via 74HCT541 buffer.
# To enable: add AXIS_A/JOINT_3 to the INI, set JOINTS=4, COORDINATES=XYZA,
# and add the joint.3 block mirroring joint.2 above (gpio-step=1, gpio-dir=0).


# Metrics
net seq-out          rp2040_eth.0.seq-out => conv-seq-out.in
net seq-in           rp2040_eth.0.seq-in  => conv-seq-in.in

setp sum2.0.gain1 -1
net seq-out-f        conv-seq-out.out => sum2.0.in0
net seq-in-f         conv-seq-in.out  => sum2.0.in1
net seq-latency      sum2.0.out

# Spindle
setp rp2040_eth.0.spindle.0.vfd-type  [RP2040_ETH_VFD_TYPES]VFD_TYPE_LOOPBACK
net spindle-fwd       spindle.0.forward  => rp2040_eth.0.spindle.0.fwd
net spindle-rev       spindle.0.reverse  => rp2040_eth.0.spindle.0.rev
net spindle-speed-cmd spindle.0.speed-out => rp2040_eth.0.spindle.0.speed-cmd
net spindle-speed-fb  spindle.0.speed-in  <= rp2040_eth.0.spindle.0.speed-fb
net spindle-at-speed  spindle.0.at-speed  <= rp2040_eth.0.spindle.0.at-speed


# GPIO — J6 GPIO_FAST (native RP2040 GPIO, GP8-GP15)
# Direction not fixed by hardware: set each to NATIVE_IN or NATIVE_OUT for your application.
setp rp2040_eth.0.gpio.00.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_NATIVE_OUT_DEBUG
setp rp2040_eth.0.gpio.00.index     8

setp rp2040_eth.0.gpio.01.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_NATIVE_IN_DEBUG
setp rp2040_eth.0.gpio.01.index     9


# GPIO — J8 I/O 1 (MCP23017 GPA5-6, address=[I2C_0]ADDRESS)
# J8:0 probe — input from probe/tool-setter
setp rp2040_eth.0.gpio.16.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_IN_PULLUP
setp rp2040_eth.0.gpio.16.index     5
setp rp2040_eth.0.gpio.16.address   [I2C_0]ADDRESS
net probe-in  rp2040_eth.0.gpio.16.in

# J8:2 alarm — input (e.g. stepper driver fault)
setp rp2040_eth.0.gpio.17.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_IN_PULLUP
setp rp2040_eth.0.gpio.17.index     6
setp rp2040_eth.0.gpio.17.address   [I2C_0]ADDRESS
net alarm-in  rp2040_eth.0.gpio.17.in


# GPIO — J9 I/O 2 (MCP23017 GPA3-4, address=[I2C_0]ADDRESS)
# J9:0 hold — input (feed hold)
setp rp2040_eth.0.gpio.18.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_IN_PULLUP
setp rp2040_eth.0.gpio.18.index     4
setp rp2040_eth.0.gpio.18.address   [I2C_0]ADDRESS
net hold-in   rp2040_eth.0.gpio.18.in

# J9:2 start — input (cycle start)
setp rp2040_eth.0.gpio.19.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_IN_PULLUP
setp rp2040_eth.0.gpio.19.index     3
setp rp2040_eth.0.gpio.19.address   [I2C_0]ADDRESS
net start-in  rp2040_eth.0.gpio.19.in


# GPIO — J10 I/O 3 (MCP23017 GPA1-2, address=[I2C_0]ADDRESS)
# J10:0 pump — output (coolant pump)
setp rp2040_eth.0.gpio.20.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_OUT
setp rp2040_eth.0.gpio.20.index     2
setp rp2040_eth.0.gpio.20.address   [I2C_0]ADDRESS
net pump-out  rp2040_eth.0.gpio.20.out

# J10:2 mist — output (mist coolant)
setp rp2040_eth.0.gpio.21.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_OUT
setp rp2040_eth.0.gpio.21.index     1
setp rp2040_eth.0.gpio.21.address   [I2C_0]ADDRESS
net mist-out  rp2040_eth.0.gpio.21.out


# GPIO — J11 LED (MCP23017 GPB7 + GPA7, address=[I2C_0]ADDRESS)
# J11:0 pkt — output (packet activity LED)
setp rp2040_eth.0.gpio.22.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_OUT
setp rp2040_eth.0.gpio.22.index     7
setp rp2040_eth.0.gpio.22.address   [I2C_0]ADDRESS
net pkt-out   rp2040_eth.0.gpio.22.out

# J11:2 err — output (error LED)
setp rp2040_eth.0.gpio.23.type      [RP2040_ETH_GPIO_TYPES]GPIO_TYPE_I2C_MCP_OUT
setp rp2040_eth.0.gpio.23.index     15
setp rp2040_eth.0.gpio.23.address   [I2C_0]ADDRESS
net err-out   rp2040_eth.0.gpio.23.out
